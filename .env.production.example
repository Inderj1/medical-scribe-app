# Production Environment Variables
# Copy this file to .env and update with your actual values

# Database Configuration
DATABASE_HOST=your-rds-endpoint.amazonaws.com
DATABASE_PORT=5432
DATABASE_NAME=medical_scribe
DATABASE_USER=medscribe
DATABASE_PASSWORD=your_secure_password
DATABASE_URL=postgresql://medscribe:your_secure_password@your-rds-endpoint.amazonaws.com:5432/medical_scribe

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Application Configuration
SECRET_KEY=your_generated_secret_key_here
ENVIRONMENT=production
LOG_LEVEL=info

# Authentication (Clerk)
CLERK_SECRET_KEY=sk_live_your_clerk_secret_key
REACT_APP_CLERK_PUBLISHABLE_KEY=pk_live_your_clerk_publishable_key

# OpenAI Configuration
OPENAI_API_KEY=sk-your_openai_api_key_here

# EHR Integration
OPENEHR_API_URL=http://98.86.40.56

# CORS Configuration
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# AWS Configuration (Optional - for S3 uploads)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=medical-scribe-uploads

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Monitoring (Optional)
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# Frontend URL
FRONTEND_URL=https://yourdomain.com