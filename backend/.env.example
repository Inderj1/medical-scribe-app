# Application
APP_NAME=MedicalScribe
APP_VERSION=1.0.0
DEBUG=True
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=postgresql://user:password@localhost/medical_scribe_db
REDIS_URL=redis://localhost:6379/0

# AI Services
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Audio Processing
MAX_AUDIO_SIZE_MB=100
AUDIO_CHUNK_SIZE=4096
WHISPER_MODEL=whisper-1

# WebSocket
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS_PER_USER=5

# Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=medical-audio

# Security
CORS_ORIGINS=["http://localhost:3000", "https://localhost:3000"]
ALLOWED_HOSTS=["localhost", "127.0.0.1"]

# Epic Configuration
EPIC_CLIENT_ID=0eb42959-ba12-4e23-81c9-0a523d40fd4a
EPIC_CLIENT_SECRET=your-epic-client-secret
EPIC_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth
EPIC_USE_SANDBOX=true